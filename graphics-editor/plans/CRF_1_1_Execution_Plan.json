  "proofObligations": [
    {
      "id": "P1",
      "kind": "formal",
      "title": "Patch字段不变性",
      "implementationScope": "abstract PatchIR, separate implementation correspondence",
      "plannedChecker": "Lean",
      "status": "not_run"
    },
    {
      "id": "P2",
      "kind": "formal_and_exhaustive",
      "title": "保守影响域外不变",
      "implementationScope": "conditional effect semantics plus actual finite frame check",
      "plannedChecker": "Lean + runtime witness",
      "status": "not_run"
    },
    {
      "id": "P3",
      "kind": "formal",
      "title": "SDR固定点预乘合成边界与恒等",
      "implementationScope": "declared fixed-point operator, not arbitrary HDR or WGSL",
      "plannedChecker": "Lean + bitvector checks",
      "status": "not_run"
    },
    {
      "id": "P4",
      "kind": "finite_constraint_and_witness",
      "title": "锚点与实际像素连接",
      "implementationScope": "declared scene and actual contribution frame",
      "plannedChecker": "Z3 + pixel-path checker",
      "status": "not_run"
    },
    {
      "id": "P5",
      "kind": "formal",
      "title": "晋升状态机与必需证据",
      "implementationScope": "pure transition rules, runtime orchestration tested separately",
      "plannedChecker": "Lean + fault injection",
      "status": "not_run"
    },
    {
      "id": "P6",
      "kind": "constraint",
      "title": "非空ROI及前提可满足",
      "implementationScope": "current contract and bounded constraints",
      "plannedChecker": "Z3 + runtime validation",
      "status": "not_run"
    }
  ],
  "dataProtocol": {
    "candidateSearchRounds": 10,
    "targetIndependentSourceGroups": 60,
    "splitBy": "original photography source and object identity",
    "developmentGroups": 30,
    "selectionGroups": 15,
    "sealedGroups": 15,
    "legacyRegressionSeparate": true,
    "derivedImageCrossSplitAllowed": false,
    "sealedExecutionsPerFrozenReleaseCandidate": 1,
    "proposalModelSeesSealedImagesOrPerCaseFeedback": false,
    "frozenFitterMayReadTargetObservation": true,
    "sealedFailureUsedForFurtherRepair": "reclassify consumed set and create new sealed version"
  },
  "acceptance": {
    "thresholdStatus": "proposed; calibrate on development data and freeze at M0 before sealed testing",
    "gates": [
      {
        "id": "G-legacy",
        "gate": "required",
        "criterion": "preserve all legacy cases/assets/URLs; strict-profile compatibility replay"
      },
      {
        "id": "G-protected",
        "gate": "required",
        "criterion": "outside authorized conservative influence footprint, exact RGBA equality on strict reference path"
      },
      {
        "id": "G-edge",
        "gate": "required",
        "truthRequired": true,
        "candidateMayDefineEvaluationMask": false,
        "boundaryBandOutputPixels": [
          1,
          3
        ],
        "medianMAEReductionTarget": 0.2,
        "additionalGuards": [
          "gradient error",
          "contour displacement",
          "absolute tolerance near zero baseline"
        ]
      },
      {
        "id": "G-fit",
        "gate": "required",
        "medianPSNRGainTargetDb": 0.5,
        "perCaseRegressionLimitDb": 0.1,
        "fallbackReportedSeparately": true,
        "countAuxiliaryRepresentationCost": true
      },
      {
        "id": "G-gpu",
        "gate": "required_if_gpu_enabled",
        "maxDisplayChannelErrorTarget": 0.00784313725490196,
        "p99DisplayChannelErrorTarget": 0.00392156862745098,
        "linearErrorAlsoReported": true,
        "notAUniversalCrossHardwareProof": true
      },
      {
        "id": "G-interactive",
        "gate": "required_for_realtime_acceleration_claim",
        "width": 1024,
        "height": 768,
        "maxActualGaussians": 65536,
        "maxDependencyExpandedDirtyFraction": 0.25,
        "eventToNewFrameP95TargetMs": 100,
        "fullVerificationLatencySeparate": true
      },
      {
        "id": "G-video",
        "gate": "required",
        "durationSeconds": 5,
        "fps": 24,
        "frames": 120,
        "representation": "image_plane_motion",
        "temporalProtocol": "freeze scale and coordinate-compensated residual tolerances at M0"
      },
      {
        "id": "G-formal",
        "gate": "required",
        "coreLeanClaims": [
          "P1",
          "P2",
          "P3",
          "P5"
        ],
        "instanceChecks": [
          "P4",
          "P6"
        ],
        "sorryAllowed": false,
        "trustedComputingBaseExplicit": true,
        "specOnlyCannotCertifyImplementation": true
      },
      {
        "id": "G-rsi",
        "gate": "required",
        "minActualNonParameterOperatorPrograms": 1,
        "medianTargetErrorReductionVersusFixed11": 0.1,
        "minSearchTrajectories": 3,
        "isolatedL2AblationRequired": true,
        "executedOperatorTraceRequired": true,
        "newTaskMustUsePromotedOperator": true,
        "applicabilityFrozenBeforeSealed": true,
        "fallbackCoverageAndRawCandidateGainsSeparate": true
      },
      {
        "id": "G-photo",
        "gate": "required_for_photographic_quality_improvement_claim; diagnostic_for_technical_release",
        "minIndependentTargetScenes": 20,
        "minValidHumanReviewersPerScene": 3,
        "scenePairwiseWinRateTarget": 0.6,
        "uncertaintyProtocol": "pre-register clustered scene/source interval; require support for improvement, otherwise inconclusive",
        "modelCannotFillHumanReview": true
      }
    ],
    "overallStatus": "not_run"
  },
  "experimentArms": [
    "1.0 + existing parameter loop",
    "1.1 fixed kernel and pipeline",
