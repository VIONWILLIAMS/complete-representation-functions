{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crf.dev/schemas/crf-dsl-ast.schema.json",
  "title": "CRF DSL AST",
  "type": "object",
  "required": ["domain", "type"],
  "properties": {
    "domain": {"type": "string"},
    "type": {"type": "string"},
    "name": {"type": "string"},
    "args": {"type": "object"},
    "children": {
      "type": "array",
      "items": {"$ref": "#"}
    },
    "source": {"type": "string"}
  }
}
